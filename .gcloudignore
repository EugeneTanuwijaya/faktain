# Keep the Cloud Build upload small. Docker builds run `npm ci` and pip
# install inside the build, so local deps/artifacts are not needed.
.git/
.gitignore

# Node / Next.js
**/node_modules/
**/.next/
frontend/.env*.local

# Python
**/__pycache__/
**/*.pyc
backend/.venv/
backend/venv/

# Local-only backend files
backend/.env
backend/diag_verdict_live.py

# Tooling / IDE / docs noise
.vscode/
.kiro/
.playwright-mcp/
*.png
*.md
