GCP_PROJECT_ID=
FRONTEND_URL=http://localhost:3000
NEWS_CACHE_TTL=3600

# Optional Firebase authentication. Empty = guest mode.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Default quota. For local development, override ANON_RATE_LIMIT=100 and
# USER_RATE_LIMIT=500 in your private .env; keep production limits deliberate.
# Browser and live test requests from localhost share the anonymous IP quota.
RATE_LIMIT_WINDOW=3600
ANON_RATE_LIMIT=5
USER_RATE_LIMIT=50

# 9Router OpenAI-compatible API. Use exact IDs returned by /v1/models.
LLM_PROVIDER=9router
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODELS=
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=2500
LLM_HEALTH_TIMEOUT=10

# Images always use this model, without text-only fallback.
LLM_VISION_MODEL=
# Only if /models omits capabilities. List confirmed vision model IDs, not guesses.
LLM_VISION_MODELS=

# Enable real web search. Without retrieved article evidence results stay insufficient.
LLM_WEB_SEARCH=true
LLM_WEB_MAX_RESULTS=5
LLM_WEB_MODE=external
# DuckDuckGo HTML discovery; no search API key. CAPTCHA/rate limits are service failures.
SEARCH_PROVIDER=duckduckgo
# Enable when local DNS blocks DuckDuckGo; only the search hostname uses Cloudflare DoH.
SEARCH_DNS_OVER_HTTPS=false
# Legacy OpenRouter only: LLM_PROVIDER=openrouter, explicit base URL,
# LLM_WEB_MODE=plugin or server_tool, LLM_WEB_ENGINE=exa.
VERIFICATION_TIMEOUT=100

# Langflow owns all normal AI tasks; native comparison is only a bounded fallback.
ORCHESTRATION_BACKEND=langflow
LANGFLOW_URL=http://127.0.0.1:7860
LANGFLOW_API_KEY=
LANGFLOW_TEXT_FLOW_ID=
LANGFLOW_IMAGE_FLOW_ID=
LANGFLOW_SUMMARY_FLOW_ID=
# Shared with secret global FAKTAIN_SERVICE_KEY in Langflow; never expose in frontend.
LANGFLOW_SERVICE_KEY=
LANGFLOW_NATIVE_FALLBACK=true
