GCP_PROJECT_ID=your_gcp_project_id
FRONTEND_URL=http://localhost:3000
NEWS_CACHE_TTL=3600

# Google Gemini Developer API
# Get a free key at https://aistudio.google.com/apikey (starts with "AIza")
GEMINI_API_KEY=your_gemini_api_key_here
# Model name. Confirm available models for your key via the /models endpoint.
GEMINI_MODEL=gemini-2.5-flash
# Grounding with Google Search: live web verification, free up to 5k req/month.
GEMINI_GROUNDING=true
# Max output tokens.
GEMINI_MAX_TOKENS=4096
# Internal reasoning budget for thinking models (2.5+). 0 disables thinking so
# the full token budget goes to the JSON output. Raise if you want reasoning.
GEMINI_THINKING_BUDGET=0
# Auto-retry on 429 (rate limit). Retries N times using the delay Gemini
# reports (Retry-After / retryDelay), capped at GEMINI_MAX_RETRY_WAIT seconds.
# Smooths over per-minute (RPM) limits; daily (RPD) exhaustion still surfaces.
GEMINI_MAX_RETRIES=2
GEMINI_MAX_RETRY_WAIT=60
