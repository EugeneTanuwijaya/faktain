GCP_PROJECT_ID=your_gcp_project_id
FRONTEND_URL=http://localhost:3000
NEWS_CACHE_TTL=3600

# ── Firebase Auth (optional) ─────────────────────────────────────────────
# Set to your Firebase project id to enable ID-token verification. Leave empty
# to run fully anonymous (only IP rate limits apply). Usually same as the GCP
# project id.
FIREBASE_PROJECT_ID=
# Optional path to a service-account JSON. On GCP, Application Default
# Credentials are used automatically, so this can stay empty.
GOOGLE_APPLICATION_CREDENTIALS=

# ── Rate limiting for /analyze ───────────────────────────────────────────
# Sliding window in seconds, plus per-window quotas for anonymous (per IP) and
# signed-in (per user) callers.
RATE_LIMIT_WINDOW=3600
ANON_RATE_LIMIT=5
USER_RATE_LIMIT=50

# OpenRouter (OpenAI-compatible API)
# Get a key at https://openrouter.ai/settings/keys
LLM_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
# Analysis model. Browse models at openrouter.ai/models (filter: free)
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Fallback models tried when the primary returns 429 or junk
LLM_FALLBACK_MODELS=openai/gpt-oss-120b:free,z-ai/glm-4.5-air:free
# Retries per model before moving to the next fallback
LLM_MAX_RETRIES=3
# Max completion tokens (keep modest to avoid 402 credit-reservation errors)
LLM_MAX_TOKENS=2048

# Web search via OpenRouter "web" plugin.
# Enable Firecrawl as the search engine in OpenRouter's dashboard:
#   openrouter.ai/settings/byok -> Web Search tab -> accept Firecrawl ToS
#   (or Plugin settings -> set Firecrawl as Web Search engine)
# New accounts get free Firecrawl credits; no separate Firecrawl key needed.
LLM_WEB_SEARCH=true
LLM_WEB_MAX_RESULTS=5
